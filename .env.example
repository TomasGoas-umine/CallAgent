# Umine Voice — variables de entorno (solo nombres/placeholders, nunca valores reales)

NODE_ENV=local
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_NAME=umine-voice-local

TABLERO_API_MODE=fixture
TABLERO_API_BASE_URL=
TABLERO_API_TOKEN=

MOCK_PROVIDERS=true
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Minutos de gracia antes de que `calls:sync` considere colgado un seguimiento en DIALING
TWILIO_RECONCILE_GRACE_MINUTES=

# Grabacion de audio de la llamada. Decision de negocio abierta (UV-026): el piloto asume false.
CALL_RECORDING_ENABLED=false
# URL publica por la que ElevenLabs puede alcanzar este server. La escribe `npm run tunnel:up`
# (quick tunnel de cloudflared). Sin esto el webhook post-call no llega y los FOLLOWUP quedan
# en DIALING. Verifica el circuito con `npm run webhook:selftest`.
PUBLIC_BASE_URL=

KILL_SWITCH=false
DRY_RUN=true
DAILY_QUOTA=5
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
TIMEZONE=America/Santiago
MAX_ATTEMPTS=3
COOLDOWN_HOURS=24
ALLOWLIST_NUMBERS=

# Whitelist DURA de la etapa de pruebas de llamadas reales (segunda barrera, ademas de
# ALLOWLIST_NUMBERS). Si no se setea, el default del codigo es el unico numero de pruebas.
# Solo la suite de tests la sobreescribe. Ver src/services/guardrails.ts.
TEST_PHONE_WHITELIST=

# Enfriamiento entre disparos automaticos del Tablero Mock, POR OC (segundos, default 300).
MOCK_CALL_COOLDOWN_SECONDS=

# Solo para tests: acorta el backoff de reintento de 24h a segundos
RETRY_BACKOFF_SECONDS_OVERRIDE=

LOCAL_SERVER_PORT=3000

# Webhook registrado por npm run webhook:connect (requiere permiso webhooks_write).
# El secreto HMAC real se guarda automaticamente en ELEVENLABS_WEBHOOK_SECRET.
ELEVENLABS_WEBHOOK_ID=
# Opcional: rama del agente; vacio usa la principal.
ELEVENLABS_AGENT_BRANCH_ID=
# Gateway local que publica SOLO el webhook, nunca /api ni /internal.
WEBHOOK_GATEWAY_PORT=3001
