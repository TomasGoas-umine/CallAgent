{
  "name": "umine-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Umine Voice \u2014 agente de voz que detecta urgencias en el Semaforo operacional, llama via Twilio+ElevenLabs y registra el resultado.",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "local:up": "tsx --env-file=.env scripts/local-dynamo-up.ts",
    "local:down": "tsx --env-file=.env scripts/local-dynamo-down.ts",
    "local:create-tables": "tsx --env-file=.env scripts/create-local-tables.ts",
    "local:seed": "tsx --env-file=.env scripts/seed-local.ts",
    "local:server": "tsx --env-file=.env src/local/server.ts",
    "local:demo": "tsx --env-file=.env scripts/local-demo.ts",
    "fixture:generate": "tsx scripts/generate-fixture.ts",
    "semaforo:probe": "tsx --env-file=.env scripts/semaforo-probe.ts",
    "semaforo:capture-sample": "tsx scripts/capture-real-sample.ts",
    "providers:check": "tsx --env-file=.env scripts/providers-check.ts",
    "agent:check": "tsx --env-file=.env scripts/agent-check.ts",
    "tunnel:up": "tsx --env-file=.env scripts/tunnel-up.ts",
    "webhook:selftest": "tsx --env-file=.env scripts/webhook-selftest.ts",
    "calls:sync": "tsx --env-file=.env scripts/calls-sync.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "webhook:configure": "tsx --env-file=.env scripts/webhook-configure.ts",
    "webhook:connect": "tsx --env-file=.env scripts/tunnel-up.ts --configure",
    "agent:configure": "tsx --env-file=.env scripts/agent-configure.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.649.0",
    "@aws-sdk/lib-dynamodb": "^3.649.0",
    "fastify": "^5.12.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "aws-cdk": "^2.160.0",
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0",
    "dynalite": "^4.0.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
